{
  "name": "website",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -w libs:build && pnpm -w gen:llms && next dev --webpack -p 3000",
    "build": "pnpm -w libs:build && pnpm -w gen:llms && next build --webpack",
    "start": "next start -p 3000",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -w libs:build && next typegen && tsc --noEmit",
    "cf:build": "node scripts/require-analytics-env.mjs && pnpm -w libs:build && pnpm -w gen:llms && opennextjs-cloudflare build && node scripts/copy-asset-headers.mjs",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@ogpeek/react": "workspace:*",
    "ipaddr.js": "2.5.0",
    "next": "16.4.2",
    "ogpeek": "workspace:*",
    "posthog-js": "1.438.12",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@next/env": "16.4.2",
    "@opennextjs/cloudflare": "^1.20.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "10.6.1",
    "postcss": "8.5.30",
    "sharp": "^0.34.5",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vitest": "2.1.9",
    "wrangler": "^4.151.0"
  }
}
