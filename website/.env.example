# User-Agent used when fetching upstream pages. Default is a browser-like
# value that passes through most CDNs. Adjust if a specific site returns 403.
# OGPEEK_USER_AGENT="Mozilla/5.0 ..."

# Per-IP request limit per minute. Zero or below disables the limit.
# Default is 20.
# OGPEEK_RATE_LIMIT_PER_MIN=20

# The SSRF guard in website/lib/ssrf-guard.ts is always on. To parse internal
# staging hosts, edit ssrf-guard.ts on the deployed instance directly or add
# environment-aware allow-list logic. Never disable the guard in a public
# deployment.

# PostHog (browser analytics). Build-time inlined via next.config.ts `env`, NOT
# read at runtime. Production only: the values live in the Workers Builds
# production trigger's build variables (never a Worker secret, never a repo
# file). Without POSTHOG_KEY the app simply skips init. `cf:build` requires the
# key only on the production build (WORKERS_CI_BRANCH=main); set
# OGPEEK_ALLOW_NO_ANALYTICS=1 there to ship without analytics on purpose.
# POSTHOG_KEY="phc_..."
# POSTHOG_HOST="https://us.i.posthog.com"  # or a reverse proxy, e.g. https://z.minjun.kim
