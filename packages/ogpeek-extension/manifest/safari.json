{
  "manifest_version": 3,
  "name": "ogpeek",
  "version": "0.0.1",
  "description": "Peek into any page's Open Graph tags from your own machine — no server in the loop.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "ogpeek"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["<all_urls>"]
}
