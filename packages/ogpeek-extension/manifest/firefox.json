{
  "manifest_version": 3,
  "name": "ogpeek",
  "version": "0.0.1",
  "description": "Peek into any page's Open Graph tags from your own machine — no server in the loop.",
  "browser_specific_settings": {
    "gecko": {
      "id": "ogpeek@minjun.dev",
      "strict_min_version": "115.0"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ogpeek",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "permissions": ["activeTab"],
  "host_permissions": ["<all_urls>"]
}
